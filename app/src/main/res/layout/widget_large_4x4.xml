<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/app_name" />
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:textColor="@color/widget_title"
            android:textSize="17sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_accent"
            android:textSize="11sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="暂无进行中作业"
        android:textColor="@color/widget_muted"
        android:textSize="15sp" />
    <TextView
        android:id="@+id/widget_task_title_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp"
        android:maxLines="1"
        android:textColor="@color/widget_title"
        android:textSize="15sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_task_subtitle_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/widget_task_title_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:maxLines="1"
        android:textColor="@color/widget_title"
        android:textSize="15sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_task_subtitle_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/widget_task_title_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:maxLines="1"
        android:textColor="@color/widget_title"
        android:textSize="15sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_task_subtitle_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/widget_task_title_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:maxLines="1"
        android:textColor="@color/widget_title"
        android:textSize="15sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_task_subtitle_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/widget_task_title_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:maxLines="1"
        android:textColor="@color/widget_title"
        android:textSize="15sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_task_subtitle_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />
</LinearLayout>
